NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMMERCE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Required to protect /admin in production (password + TOTP; secrets: 32+ chars)
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_TOTP_SECRET=REPLACE_WITH_TOTP_BASE32_SECRET
SESSION_SECRET=replace-with-random-32-byte-secret

# Required for catalog, orders, accounts and admin features
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_SUBMISSIONS_TABLE=submissions

# Required for real payments
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_AUTOMATIC_TAX=true

# Required for transactional emails and contact forms
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=hello@example.com
CONTACT_TO_EMAIL=hello@example.com
ORDERS_TO_EMAIL=orders@example.com

# Business configuration
BUSINESS_NAME=AVANA
BUSINESS_SUPPORT_EMAIL=support@example.com
BUSINESS_PHONE=+1-555-0100
BUSINESS_ADDRESS_LINE1=123 Example Street
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=Example City
BUSINESS_PROVINCE=QC
BUSINESS_POSTAL_CODE=H0H 0H0
BUSINESS_COUNTRY=CA
STANDARD_SHIPPING_CENTS=800
EXPRESS_SHIPPING_CENTS=1600
FREE_SHIPPING_THRESHOLD_CENTS=6000
ORDER_RESERVATION_MINUTES=30
LOW_STOCK_THRESHOLD=5

# Optional: Canada Post tracking sync
CANADA_POST_USERNAME=your_canada_post_username
CANADA_POST_PASSWORD=your_canada_post_password
CANADA_POST_ENVIRONMENT=development

# Required for production scheduled tasks
CRON_SECRET=replace_with_a_random_32_byte_secret
