NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMMERCE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required to protect /admin in production (password + TOTP; secrets: 32+ chars)
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
SESSION_SECRET=

# Required for catalog, orders, accounts and admin features
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SUBMISSIONS_TABLE=submissions

# Required for real payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=true

# Required for transactional emails and contact forms
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
ORDERS_TO_EMAIL=

# Business configuration
BUSINESS_NAME=AVANA
BUSINESS_SUPPORT_EMAIL=support@example.com
BUSINESS_PHONE=+1-555-0100
BUSINESS_ADDRESS_LINE1=123 Example Street
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=Example City
BUSINESS_PROVINCE=QC
BUSINESS_POSTAL_CODE=H0H 0H0
BUSINESS_COUNTRY=CA
STANDARD_SHIPPING_CENTS=800
EXPRESS_SHIPPING_CENTS=1600
FREE_SHIPPING_THRESHOLD_CENTS=6000
ORDER_RESERVATION_MINUTES=30
LOW_STOCK_THRESHOLD=5

# Optional: Canada Post tracking sync
CANADA_POST_USERNAME=
CANADA_POST_PASSWORD=
CANADA_POST_ENVIRONMENT=development

# Required for production scheduled tasks
CRON_SECRET=
